{{! exp-mirror-display template - based on working exp-lookit-webcam-display }}
<div class="exp-mirror-display">
    <div class="row webcam-row">
        <div class="row recorder-container">
            <div id="recorder" class="recorder col-xs-12">
                {{! Webcam will be attached here automatically by VideoRecord mixin }}
            </div>
        </div>
    </div>
    
    <div class="row">
        <div class="mirror-timer">
            {{formattedTimeRemaining}}
        </div>
        
        {{#if instructionText}}
            <div class="mirror-instruction-text">
                {{instructionText}}
            </div>
        {{/if}}
    </div>
    
    <div class="row exp-mirror-controls">
        <div class="col-sm-12 pull-down">
            {{#if showPreviousButton}}
                <button type="button" class="btn btn-default pull-left" {{ action "previous" }}>
                    Previous
                </button>
            {{/if}}

            <button type="button" id="nextbutton" class="btn btn-success pull-right" {{ action "proceed" }}>
                {{nextButtonText}}
            </button>
        </div>
    </div>
    
    {{#if showExitConfirmation}}
        <div class="mirror-exit-confirmation">
            <div class="mirror-exit-dialog">
                <h3>Are you sure you want to exit?</h3>
                <div class="mirror-button-container">
                    <button class="mirror-exit-yes" {{action "confirmExit"}}>Yes</button>
                    <button class="mirror-exit-no" {{action "cancelExit"}}>No</button>
                </div>
            </div>
        </div>
    {{/if}}
</div>