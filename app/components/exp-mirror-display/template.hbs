{{! exp-mirror-display template }}
<div class="exp-mirror-display">
    {{! Key element - this ID must match recorderElement in the component }}
    <div id="recorder" class="mirror-container">
        {{! Video recorder will be attached to this element automatically }}
    </div>
    
    <div class="mirror-timer">
        {{formattedTimeRemaining}}
    </div>
    
    {{#if instructionText}}
        <div class="mirror-instruction-text">
            {{instructionText}}
        </div>
    {{/if}}
    
    {{#if showExitConfirmation}}
        <div class="mirror-exit-confirmation">
            <div class="mirror-exit-dialog">
                <h3>Are you sure you want to exit?</h3>
                <div class="mirror-button-container">
                    <button class="mirror-exit-yes" {{action "confirmExit"}}>Yes</button>
                    <button class="mirror-exit-no" {{action "cancelExit"}}>No</button>
                </div>
            </div>
        </div>
    {{/if}}
</div>