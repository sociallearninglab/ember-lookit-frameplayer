{{! template.hbs }}

<div class="exp-lookit-mirror exp-lookit-webcam-display">

    <style>
        /* Force the entire page to have no margins or padding, removing all borders */
        body, html, .ember-view {
            margin: 0 !important;
            padding: 0 !important;
            overflow: hidden !important; /* Prevents scrollbars from appearing */
        }

        /* Force the frame container to take up the full screen */
        .exp-lookit-mirror {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: #000;
        }

        /* Make the recorder container and the recorder itself fill the frame */
        .exp-lookit-mirror .recorder-container,
        .exp-lookit-mirror #recorder {
            width: 100% !important;
            height: 100% !important;
            max-width: none !important;
            max-height: none !important;
            border: none !important;
        }

        /* Find the actual video element and style it to be a fullscreen mirror */
        .exp-lookit-mirror #recorder video {
            transform: scaleX(-1); /* Flip horizontally */
            object-fit: cover;     /* Ensure it covers the whole area without distortion */
            width: 100%;
            height: 100%;
        }

        /* Hide any standard text or control elements from the base frames */
        .exp-lookit-mirror .exp-text,
        .exp-lookit-mirror .exp-lookit-observation-controls {
            display: none !important;
        }

        /* Styles for the exit confirmation modal */
        .mirror-exit-confirmation {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.7);
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #333;
        }
        .mirror-exit-dialog {
            background: white;
            padding: 2.5em 3.5em;
            border-radius: 12px;
            text-align: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }
    </style>

    {{! The standard recorder container from the base frame. Our CSS will style it. }}
    <div class="row webcam-row">
        <div class="row recorder-container">
            <div id="recorder" class="recorder col-xs-12">
            </div>
        </div>
    </div>

    {{! The exit confirmation modal is the only UI overlay left. }}
    {{#if showExitConfirmation}}
        <div class="mirror-exit-confirmation">
            <div class="mirror-exit-dialog">
                <h3>Are you sure you want to end early?</h3>
                <div style="margin-top: 1.5em;">
                    <button class="btn btn-danger" {{action "confirmExit"}} style="margin-right: 1em;">Yes, End Now</button>
                    <button class="btn btn-default" {{action "cancelExit"}}>No, Continue</button>
                </div>
            </div>
        </div>
    {{/if}}

</div>